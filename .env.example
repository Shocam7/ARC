# ─── ARC Environment Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Your Google Gemini API key
# Get it free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Google Cloud Project ID (for Cloud Speech-to-Text fallback)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Set to "1" to enable verbose debug logging
# ARC_DEBUG=0
