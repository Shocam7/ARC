# ─── ARC Environment Configuration — Vertex AI Edition ────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.

# ── Required: Google Cloud Project ────────────────────────────────────────────
# Your Google Cloud Project ID.
# Find it at: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Required: Region ──────────────────────────────────────────────────────────
# The Vertex AI region. Use 'us-central1' for widest model availability.
# Other options: europe-west1, asia-northeast1, us-east4
# For the Live API, 'global' or 'us-central1' are recommended.
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional: Service Account Key (Production) ────────────────────────────────
# For production / CI / running without gcloud CLI.
# Point this to your Service Account JSON key file.
# Download from: IAM & Admin → Service Accounts → Create Key → JSON
#
# Leave this UNSET during local development if you've run:
#   gcloud auth application-default login
#
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ── Optional: Debug ───────────────────────────────────────────────────────────
# Set to "1" to enable verbose debug logging.
# ARC_DEBUG=0
